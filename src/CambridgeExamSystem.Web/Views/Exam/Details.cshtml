@model ExamPaperDetailDto
@{
    var exam = Model.Summary;
    ViewData["Title"] = exam.ExamName;
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Đề thi</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-level="@exam.LevelCode">@exam.LevelName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@exam.ExamCode</li>
    </ol>
</nav>
<div class="row g-4">
    <div class="col-lg-8">
        <h1 class="h3">@exam.ExamName</h1>
        <p class="text-muted">@exam.Description</p>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Phần thi</th><th class="text-end">Số câu</th><th class="text-end">Điểm</th></tr></thead>
                <tbody>
                    @foreach (var sec in Model.Sections)
                    {
                        <tr>
                            <td><span class="badge @DisplayFormat.SectionBadge(sec.SectionCode) me-2">@sec.SectionCode</span>@sec.SectionName <small class="text-muted d-block">@sec.SectionDescription</small></td>
                            <td class="text-end">@sec.QuestionCount</td>
                            <td class="text-end">@DisplayFormat.Score(sec.MaxScore)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.History.Count > 0)
        {
            <h2 class="h5 mt-4">Lịch sử làm đề này</h2>
            <partial name="~/Views/Result/_HistoryTable.cshtml" model="Model.History" />
        }
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <ul class="list-unstyled mb-3">
                    <li><strong>Thời gian:</strong> @exam.DurationMinutes phút</li>
                    <li><strong>Số câu:</strong> @exam.QuestionCount</li>
                    <li><strong>Tổng điểm:</strong> @DisplayFormat.Score(exam.TotalScore)</li>
                    <li><strong>Điểm đạt:</strong> @DisplayFormat.Percent(exam.PassPercentage)</li>
                    @if (exam.BestPercentage is not null)
                    {
                        <li><strong>Điểm cao nhất của bạn:</strong> @DisplayFormat.Percent(exam.BestPercentage)</li>
                    }
                </ul>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-action="Start" asp-route-id="@exam.ExamPaperId" method="post">
                        <button type="submit" class="btn btn-lg w-100 @(exam.ActiveAttemptId is null ? "btn-primary" : "btn-warning")">
                            @(exam.ActiveAttemptId is null ? "Bắt đầu làm bài" : "Tiếp tục bài đang làm")
                        </button>
                    </form>
                    <p class="small text-muted mt-2 mb-0">Bài làm được tự động lưu. Bạn có thể thoát và quay lại làm tiếp bất cứ lúc nào trước khi hết giờ.</p>
                }
                else
                {
                    <a class="btn btn-primary btn-lg w-100" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Đăng nhập để làm bài</a>
                }
            </div>
        </div>
    </div>
</div>
