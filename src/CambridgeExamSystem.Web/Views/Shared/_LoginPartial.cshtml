<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Profile">@User.Identity.Name</a>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-link nav-link">Đăng xuất</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
        <li class="nav-item"><a class="btn btn-warning btn-sm ms-lg-2 mt-1" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
    }
</ul>
