@model ExamPaperSummaryDto
<div class="card h-100 exam-card shadow-sm">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="badge bg-cambridge">@Model.LevelName</span>
            @if (Model.BestPercentage is not null)
            {
                <span class="badge bg-success" title="Điểm cao nhất">@DisplayFormat.Percent(Model.BestPercentage)</span>
            }
        </div>
        <h5 class="card-title">@Model.ExamName</h5>
        <p class="card-text text-muted small flex-grow-1">@Model.Description</p>
        <ul class="list-inline small text-muted mb-3">
            <li class="list-inline-item">@Model.DurationMinutes phút</li>
            <li class="list-inline-item">@Model.QuestionCount câu</li>
            <li class="list-inline-item">@Model.SectionCount phần</li>
            @if (Model.AttemptCount > 0)
            {
                <li class="list-inline-item">Đã làm @Model.AttemptCount lần</li>
            }
        </ul>
        @if (Model.ActiveAttemptId is long attemptId)
        {
            <a class="btn btn-warning" asp-controller="Exam" asp-action="Take" asp-route-id="@attemptId">Tiếp tục làm bài</a>
        }
        else
        {
            <a class="btn btn-outline-primary" asp-controller="Exam" asp-action="Details" asp-route-id="@Model.ExamPaperId">Xem đề</a>
        }
    </div>
</div>
