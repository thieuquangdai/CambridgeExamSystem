@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
    var title = Model?.StatusCode switch
    {
        404 => "Không tìm thấy trang",
        403 => "Bạn không có quyền truy cập",
        400 => "Yêu cầu không hợp lệ",
        _ => "Đã xảy ra lỗi"
    };
}
<div class="text-center py-5">
    <h1 class="display-5 text-danger">@(Model?.StatusCode?.ToString() ?? "Lỗi")</h1>
    <h2 class="h4">@title</h2>
    <p class="text-muted">Vui lòng thử lại hoặc quay về trang chủ.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
</div>
