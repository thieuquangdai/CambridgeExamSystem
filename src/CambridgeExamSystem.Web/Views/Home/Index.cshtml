@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}
<section class="hero rounded-4 p-4 p-md-5 mb-4 text-white">
    <h1 class="display-6 fw-bold">Luyện thi Cambridge English</h1>
    <p class="lead mb-4">Starters, Movers, Flyers, KET, PET – làm bài có tự động lưu, chấm điểm ngay, giải thích chi tiết và bảng xếp hạng.</p>
    <a class="btn btn-warning btn-lg" asp-controller="Exam" asp-action="Index">Bắt đầu luyện thi</a>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-outline-light btn-lg ms-2" asp-controller="Account" asp-action="Register">Tạo tài khoản</a>
    }
</section>

<partial name="_ActiveAttempts" model="Model.ActiveAttempts" />

<h2 class="h5 mb-3">Cấp độ</h2>
<div class="row g-3 mb-4">
    @foreach (var level in Model.Levels)
    {
        <div class="col-6 col-md-4 col-lg">
            <a class="card level-card text-decoration-none h-100" asp-controller="Exam" asp-action="Index" asp-route-level="@level.LevelCode">
                <div class="card-body text-center">
                    <div class="fw-bold text-cambridge">@level.LevelName</div>
                    <small class="text-muted">@level.PublishedExamCount đề</small>
                </div>
            </a>
        </div>
    }
</div>

<h2 class="h5 mb-3">Đề thi mới</h2>
@if (Model.LatestExams.Count == 0)
{
    <p class="text-muted">Chưa có đề thi nào được xuất bản.</p>
}
<div class="row g-3">
    @foreach (var exam in Model.LatestExams)
    {
        <div class="col-md-6 col-lg-4"><partial name="_ExamCard" model="exam" /></div>
    }
</div>
