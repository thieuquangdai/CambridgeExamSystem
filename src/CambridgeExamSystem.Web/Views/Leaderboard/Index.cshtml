@model CambridgeExamSystem.Web.Models.Leaderboard.LeaderboardViewModel
@{
    ViewData["Title"] = "Bảng xếp hạng";
    var board = Model.Board;
    var periods = new[] { (LeaderboardPeriod.Weekly, "Tuần này"), (LeaderboardPeriod.Monthly, "Tháng này"), (LeaderboardPeriod.AllTime, "Mọi thời gian") };
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">Bảng xếp hạng</h1>
    <form method="get" class="d-flex gap-2">
        <input type="hidden" name="period" value="@board.Period" />
        <select name="levelId" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Cấp độ">
            <option value="">Tất cả cấp độ</option>
            @foreach (var level in Model.Levels)
            {
                <option value="@level.LevelId" selected="@(board.LevelId == level.LevelId)">@level.LevelName</option>
            }
        </select>
    </form>
</div>
<ul class="nav nav-pills mb-3">
    @foreach (var (period, label) in periods)
    {
        <li class="nav-item"><a class="nav-link @(board.Period == period ? "active" : "")" asp-action="Index" asp-route-period="@period" asp-route-levelId="@board.LevelId">@label</a></li>
    }
</ul>
@if (board.PeriodStartDate is not null)
{
    <p class="small text-muted">Từ @board.PeriodStartDate?.ToString("dd/MM/yyyy") đến @board.PeriodEndDate?.ToString("dd/MM/yyyy")</p>
}
@if (board.CurrentUserEntry is { } me)
{
    <div class="alert alert-primary py-2">Thứ hạng của bạn: <strong>#@me.RankNumber</strong> · @me.Stars ★ · TB @DisplayFormat.Percent(me.AverageScore)</div>
}
@if (board.Entries.Count == 0)
{
    <p class="text-muted">Chưa có dữ liệu trong khoảng thời gian này.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle leaderboard">
            <thead><tr><th>#</th><th>Học viên</th><th>Hạng</th><th class="text-end">Sao</th><th class="text-end">Điểm TB</th><th class="text-end">Bài thi</th></tr></thead>
            <tbody>
                @foreach (var entry in board.Entries)
                {
                    <tr class="@(entry.IsCurrentUser ? "table-primary" : "")">
                        <td class="fw-bold">@(entry.RankNumber switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => entry.RankNumber.ToString() })</td>
                        <td>@entry.DisplayName</td>
                        <td><span class="badge @DisplayFormat.RankBadge(entry.RankCode)">@entry.RankCode</span></td>
                        <td class="text-end">@entry.Stars ★</td>
                        <td class="text-end">@DisplayFormat.Percent(entry.AverageScore)</td>
                        <td class="text-end">@entry.TotalTests</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
