@model AdminDashboardDto
@{
    ViewData["Title"] = "Quản trị";
}
<h1 class="h3 mb-3">Quản trị</h1>
<partial name="_AdminNav" />
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2"><div class="stat-card"><div class="stat-value">@Model.TotalExams</div><div class="stat-label">Đề thi</div></div></div>
    <div class="col-6 col-md-4 col-lg-2"><div class="stat-card"><div class="stat-value">@Model.PublishedExams</div><div class="stat-label">Đã xuất bản</div></div></div>
    <div class="col-6 col-md-4 col-lg-2"><div class="stat-card"><div class="stat-value">@Model.TotalQuestions</div><div class="stat-label">Câu hỏi</div></div></div>
    <div class="col-6 col-md-4 col-lg-2"><div class="stat-card"><div class="stat-value">@Model.TotalAttempts</div><div class="stat-label">Lượt làm bài</div></div></div>
    <div class="col-6 col-md-4 col-lg-2"><div class="stat-card"><div class="stat-value">@Model.SubmittedAttempts</div><div class="stat-label">Đã nộp</div></div></div>
    <div class="col-6 col-md-4 col-lg-2"><div class="stat-card"><div class="stat-value">@DisplayFormat.Percent(Model.AveragePercentage)</div><div class="stat-label">Điểm TB</div></div></div>
</div>
<div class="d-flex gap-2 flex-wrap">
    <a class="btn btn-primary" asp-action="CreateExam">+ Tạo đề thi</a>
    <a class="btn btn-outline-primary" asp-action="Exams">Quản lý đề thi</a>
    @if (User.IsInRole(RoleNames.Admin))
    {
        foreach (var period in new[] { LeaderboardPeriod.Weekly, LeaderboardPeriod.Monthly })
        {
            <form asp-action="CreateSnapshot" method="post" class="d-inline">
                <input type="hidden" name="period" value="@period" />
                <button type="submit" class="btn btn-outline-secondary">Lưu snapshot BXH @(period == LeaderboardPeriod.Weekly ? "tuần" : "tháng")</button>
            </form>
        }
    }
</div>
